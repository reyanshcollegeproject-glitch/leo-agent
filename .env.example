# =======================================================
# META MUSE AUTONOMOUS LAPTOP AGENT - CONFIGURATION
# =======================================================

# Meta AI Muse Model Settings
# Options: meta-muse-spark-1.3, meta-muse-wonder, meta-muse-code
MUSE_MODEL_NAME=meta-muse-spark-1.3

# Your Meta Model API Key or authorized endpoint
MUSE_API_KEY=your_meta_muse_api_key_here
MUSE_ENDPOINT=https://api.meta.ai/v1/models/muse

# Fallback Vision Provider (optional: OpenAI GPT-4o / Compatible local endpoints)
OPENAI_API_KEY=
FALLBACK_ENDPOINT=https://api.openai.com/v1/chat/completions

# Display & Grounding Settings
DISPLAY_INDEX=0
SCREENSHOT_MAX_WIDTH=1440
USE_COORDINATE_NORMALIZATION=true
USE_GRID_OVERLAY=true
USE_SET_OF_MARKS=true

# Execution & Safety Sentinel
STEP_DELAY_SECONDS=0.8
MAX_STEPS_PER_TASK=30
ENABLE_SENTINEL_GUARDRAILS=true
REQUIRE_CONFIRMATION_FOR_DESTRUCTIVE=true

# Real-Time Web Observer Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8765

